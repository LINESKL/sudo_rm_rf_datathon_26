API_KEY=replace-with-a-random-secret
DATA_DIR=backend/data
FRONTEND_DIR=frontend/dist
ANALYZER=ml.stub:analyze
WORKERS=3
JOB_TIMEOUT_S=280
ML_DEADLINE_S=240
MAX_UPLOAD_BYTES=209715200
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
# Per-video HttpOnly cookie for same-origin playback; force Secure behind HTTPS proxy.
MEDIA_COOKIE_TTL_S=900
MEDIA_COOKIE_SECURE=0
VLLM_ENABLED=0
VLM_BASE_URL=http://localhost:8001/v1
VLM_MODEL=Qwen/Qwen3-VL-8B-Instruct
# Fallback: Qwen/Qwen3-VL-4B-Instruct. Use matching local weights.
MODEL_PATH=/workspace/models/qwen
# After installing requirements-ml.txt and starting your VLM: ANALYZER=ml:analyze
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
