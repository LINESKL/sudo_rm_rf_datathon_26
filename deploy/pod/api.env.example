# Copy to /workspace/api.env on the pod; start_all.sh loads it for the API process.
API_KEY=replace-with-a-random-secret
DATA_DIR=/workspace/appdata
FRONTEND_DIR=/workspace/app/frontend/dist
ANALYZER=ml:analyze
WORKERS=6
VLLM_ENABLED=1
VLM_BASE_URL=http://127.0.0.1:8011/v1
VLM_MODEL=QuantTrio/Qwen3-VL-30B-A3B-Instruct-AWQ
MEDIA_COOKIE_SECURE=1
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
